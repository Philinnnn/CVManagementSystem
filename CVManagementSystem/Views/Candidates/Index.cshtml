@model CandidateProfileViewModel
@using CVManagementSystem.Services.Candidates.Dtos
@{
    ViewData["Title"] = "Profile";
    var canEdit = (bool)ViewBag.CanEdit;
    var candidateId = (int)ViewBag.CandidateId;
    var availableAttributes = canEdit ? (List<AttributeDto>)ViewBag.AvailableAttributes : [];
}

<h2>Profile</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-me">Me</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-info">Info</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-projects">Projects</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-cvs">CVs</button></li>
</ul>

<div class="tab-content pt-3">
    <div class="tab-pane fade show active" id="tab-me">
        <form asp-action="SaveProfile" method="post">
            <input type="hidden" name="candidateId" value="@candidateId" />
            <input type="hidden" name="expectedVersion" value="@Model.Profile.Version" />
            @foreach (var attr in Model.Profile.MeAttributes)
            {
                <div class="mb-3 @(attr.IsEmpty ? "border border-danger rounded p-2" : "")">
                    <label class="form-label">@attr.AttributeName</label>
                    @if (canEdit) { @RenderInput(attr) } else { @RenderReadOnly(attr) }
                </div>
            }
            @if (canEdit)
            {
                <button type="submit" class="btn btn-primary">Save</button>
            }
        </form>
    </div>

    <div class="tab-pane fade" id="tab-info">
        <form asp-action="SaveProfile" method="post">
            <input type="hidden" name="candidateId" value="@candidateId" />
            <input type="hidden" name="expectedVersion" value="@Model.Profile.Version" />
            @foreach (var attr in Model.Profile.InfoAttributes)
            {
                <div class="mb-3 @(attr.IsEmpty ? "border border-danger rounded p-2" : "")">
                    <div class="d-flex justify-content-between">
                        <label class="form-label">@attr.AttributeName</label>
                        @if (canEdit)
                        {
                            <button type="submit" formaction="@Url.Action("RemoveAttribute")" formmethod="post"
                                    name="attributeId" value="@attr.AttributeId" class="btn btn-sm btn-link text-danger p-0">Remove</button>
                        }
                    </div>
                    @if (canEdit) { @RenderInput(attr) } else { @RenderReadOnly(attr) }
                </div>
            }
            @if (canEdit)
            {
                <button type="submit" class="btn btn-primary">Save</button>
            }
        </form>

        @if (canEdit)
        {
            <hr />
            <form asp-action="AddAttribute" method="post" class="d-flex gap-2">
                <input type="hidden" name="candidateId" value="@candidateId" />
                <select name="attributeId" class="form-select">
                    @foreach (var a in availableAttributes)
                    {
                        <option value="@a.Id">@a.Name (@a.CategoryName)</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-secondary">+ Add to profile</button>
            </form>
        }
    </div>

    <div class="tab-pane fade" id="tab-projects">
        @foreach (var p in Model.Projects)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <h5>@p.Name</h5>
                    <p class="text-muted small">
                        @(p.StartDate?.ToString("yyyy-MM")) — @(p.EndDate?.ToString("yyyy-MM") ?? "present")
                        @if (p.Tags.Count > 0) { <text> · @string.Join(", ", p.Tags)</text> }
                    </p>
                    <p>@p.Description</p>
                    @if (canEdit)
                    {
                        <form asp-action="DeleteProject" method="post" onsubmit="return confirm('Delete this project?');" class="d-inline">
                            <input type="hidden" name="candidateId" value="@candidateId" />
                            <input type="hidden" name="projectId" value="@p.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </div>
            </div>
        }

        @if (canEdit)
        {
            <hr />
            <h5>New project</h5>
            <form asp-action="CreateProject" method="post">
                <input type="hidden" name="candidateId" value="@candidateId" />
                <div class="mb-2"><input name="Name" class="form-control" placeholder="Name" /></div>
                <div class="mb-2"><textarea name="Description" class="form-control" placeholder="Description (Markdown)"></textarea></div>
                <div class="row g-2 mb-2">
                    <div class="col"><input type="date" name="StartDate" class="form-control" /></div>
                    <div class="col"><input type="date" name="EndDate" class="form-control" /></div>
                </div>
                <div class="mb-2"><input name="Tags" class="form-control" placeholder="Tags, comma-separated" /></div>
                <button type="submit" class="btn btn-primary">Add project</button>
            </form>
        }
    </div>

    <div class="tab-pane fade" id="tab-cvs">
        <table class="table table-striped">
            <thead><tr><th>Position</th><th>Status</th><th>Likes</th></tr></thead>
            <tbody>
                @foreach (var cv in Model.Cvs)
                {
                    <tr>
                        <td><a asp-controller="Cvs" asp-action="Details" asp-route-id="@cv.Id">@cv.PositionName</a></td>
                        <td>@cv.Status</td>
                        <td>@cv.LikeCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent RenderInput(AttributeValueDto attr)
    {
        var key = $"attr_{attr.AttributeId}";
        return attr.DataType switch
        {
            "String" => new Microsoft.AspNetCore.Html.HtmlString($"<input type=\"text\" name=\"{key}\" value=\"{System.Net.WebUtility.HtmlEncode(attr.TextValue)}\" class=\"form-control\" />"),
            "Text" => new Microsoft.AspNetCore.Html.HtmlString($"<textarea name=\"{key}\" class=\"form-control\" rows=\"4\">{System.Net.WebUtility.HtmlEncode(attr.TextValue)}</textarea>"),
            "Image" => new Microsoft.AspNetCore.Html.HtmlString($"<input type=\"text\" name=\"{key}\" value=\"{System.Net.WebUtility.HtmlEncode(attr.TextValue)}\" class=\"form-control\" placeholder=\"Image URL\" />"),
            "Numeric" => new Microsoft.AspNetCore.Html.HtmlString($"<input type=\"number\" step=\"any\" name=\"{key}\" value=\"{attr.NumericValue}\" class=\"form-control\" />"),
            "Date" => new Microsoft.AspNetCore.Html.HtmlString($"<input type=\"date\" name=\"{key}\" value=\"{attr.DateValue:yyyy-MM-dd}\" class=\"form-control\" />"),
            "Boolean" => new Microsoft.AspNetCore.Html.HtmlString($"<input type=\"checkbox\" name=\"{key}\" {(attr.BooleanValue == true ? "checked" : "")} />"),
            "Period" => new Microsoft.AspNetCore.Html.HtmlString($"<div class=\"d-flex gap-2\"><input type=\"date\" name=\"{key}_start\" value=\"{attr.DateRangeStart:yyyy-MM-dd}\" class=\"form-control\" /><input type=\"date\" name=\"{key}_end\" value=\"{attr.DateRangeEnd:yyyy-MM-dd}\" class=\"form-control\" /></div>"),
            "Select" => RenderSelect(attr, key),
            _ => new Microsoft.AspNetCore.Html.HtmlString("")
        };
    }

    private Microsoft.AspNetCore.Html.IHtmlContent RenderSelect(AttributeValueDto attr, string key)
    {
        var options = string.Join("", attr.SelectOptions.Select(o =>
            $"<option value=\"{System.Net.WebUtility.HtmlEncode(o)}\" {(o == attr.TextValue ? "selected" : "")}>{System.Net.WebUtility.HtmlEncode(o)}</option>"));
        return new Microsoft.AspNetCore.Html.HtmlString($"<select name=\"{key}\" class=\"form-select\"><option value=\"\">--</option>{options}</select>");
    }

    private Microsoft.AspNetCore.Html.IHtmlContent RenderReadOnly(AttributeValueDto attr)
    {
        var display = attr.DataType switch
        {
            "Boolean" => attr.BooleanValue == true ? "Yes" : "No",
            "Period" => $"{attr.DateRangeStart:yyyy-MM-dd} — {attr.DateRangeEnd:yyyy-MM-dd}",
            "Date" => attr.DateValue?.ToString("yyyy-MM-dd") ?? "",
            "Numeric" => attr.NumericValue?.ToString() ?? "",
            _ => attr.TextValue ?? ""
        };
        return attr.IsEmpty
            ? new Microsoft.AspNetCore.Html.HtmlString("<em>empty</em>")
            : new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(display));
    }
}