@model CVManagementSystem.Services.Dashboard.Dtos.DashboardDto
@{
    ViewData["Title"] = Loc["home.title"];
}

<h2>@Loc["home.title"]</h2>

<div class="row mb-4">
    <div class="col-md-2">
        <div class="card text-center p-2">
            <div class="fs-4">@Model.Stats.CvsCreatedToday</div>
            <div class="text-muted small">@Loc["home.stats.cvsToday"]</div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center p-2">
            <div class="fs-4">@Model.Stats.TotalPositions</div>
            <div class="text-muted small">@Loc["home.stats.positions"]</div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center p-2">
            <div class="fs-4">@Model.Stats.TotalCandidates</div>
            <div class="text-muted small">@Loc["home.stats.candidates"]</div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center p-2">
            <div class="fs-4">@Model.Stats.TotalRecruiters</div>
            <div class="text-muted small">@Loc["home.stats.recruiters"]</div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center p-2">
            <div class="fs-4">@Model.Stats.TotalCvs</div>
            <div class="text-muted small">@Loc["home.stats.totalCvs"]</div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <h5>@Loc["home.recentPositions"]</h5>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>@Loc["home.column.name"]</th>
                    <th>@Loc["home.column.created"]</th>
                    <th>@Loc["home.column.status"]</th>
                    <th>@Loc["home.column.cvs"]</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in Model.RecentPositions)
                {
                    <tr>
                        <td>
                            <a asp-controller="Positions"
                               asp-action="Details"
                               asp-route-id="@p.Id">@p.Name</a>
                        </td>
                        <td>@p.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>@(p.Open ? Loc["home.status.open"] : Loc["home.status.closed"])</td>
                        <td>@p.CvCount</td>
                    </tr>
                }
            </tbody>
        </table>

        <h5 class="mt-4">@Loc["home.topPositions"]</h5>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>@Loc["home.column.name"]</th>
                    <th>@Loc["home.column.cvs"]</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in Model.TopPositions)
                {
                    <tr>
                        <td>
                            <a asp-controller="Positions"
                               asp-action="Details"
                               asp-route-id="@p.Id">@p.Name</a>
                        </td>
                        <td>@p.CvCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-4">
        <h5>@Loc["home.tagCloud"]</h5>

        <div>
            @foreach (var tag in Model.TagCloud)
            {
                var size = 0.8 + Math.Min(tag.Count, 10) * 0.15;
                var href = (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
                    ? Url.Action("ByTag", "Cvs", new { tag = tag.Name })
                    : Url.Action("Index", "Positions", new { tag = tag.Name });
                <a href="@href" class="badge bg-secondary me-1 mb-1 text-decoration-none" style="font-size: @(size.ToString(System.Globalization.CultureInfo.InvariantCulture))rem;">@tag.Name (@tag.Count)</a>
            }
        </div>
    </div>
</div>