@model CVManagementSystem.Services.Search.Dtos.SearchResultsDto
@{
    ViewData["Title"] = Loc["search.title"];
    var query = (string?)ViewBag.Query;
}

<h2>@Loc["search.resultsFor"] "@query"</h2>

<h5 class="mt-3">
    @Loc["search.positions"] (@Model.Positions.Count)
</h5>

@if (Model.Positions.Count == 0)
{
    <p class="text-muted">
        @Loc["search.noMatchingPositions"]
    </p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Loc["search.name"]</th>
                <th>@Loc["search.description"]</th>
                <th>@Loc["search.status"]</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in Model.Positions)
            {
                <tr>
                    <td>
                        <a asp-controller="Positions"
                           asp-action="Details"
                           asp-route-id="@p.Id">
                            @p.Name
                        </a>
                    </td>

                    <td>@p.ShortDescription</td>

                    <td>
                        @(p.Open
                            ? Loc["search.open"]
                            : Loc["search.closed"])
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
{
    <h5 class="mt-4">
        @Loc["search.candidates"] (@Model.Candidates.Count)
    </h5>

    @if (Model.Candidates.Count == 0)
    {
        <p class="text-muted">
            @Loc["search.noMatchingCandidates"]
        </p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>@Loc["search.name"]</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in Model.Candidates)
                {
                    <tr>
                        <td>
                            <a asp-controller="Candidates"
                               asp-action="Index"
                               asp-route-candidateId="@c.CandidateId">
                                @c.Fullname
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}