@model CVManagementSystem.Services.Search.Dtos.SearchResultsDto
@{
    ViewData["Title"] = "Search";
    var query = (string?)ViewBag.Query;
}

<h2>Search results for "@query"</h2>

<h5 class="mt-3">Positions (@Model.Positions.Count)</h5>
@if (Model.Positions.Count == 0)
{
    <p class="text-muted">No matching positions.</p>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Name</th><th>Description</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Positions)
        {
            <tr>
                <td><a asp-controller="Positions" asp-action="Details" asp-route-id="@p.Id">@p.Name</a></td>
                <td>@p.ShortDescription</td>
                <td>@(p.Open ? "Open" : "Closed")</td>
            </tr>
        }
        </tbody>
    </table>
}

@if (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
{
    <h5 class="mt-4">Candidates (@Model.Candidates.Count)</h5>
    @if (Model.Candidates.Count == 0)
    {
        <p class="text-muted">No matching candidates.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead><tr><th>Name</th></tr></thead>
            <tbody>
            @foreach (var c in Model.Candidates)
            {
                <tr><td><a asp-controller="Candidates" asp-action="Index" asp-route-candidateId="@c.CandidateId">@c.Fullname</a></td></tr>
            }
            </tbody>
        </table>
    }
}