@model PositionFormViewModel
@{
    ViewData["Title"] = Loc["positions.edit.title"];
    var allAttributes = (List<AttributeDto>)ViewBag.AllAttributes;
    var operators = (IReadOnlyCollection<string>)ViewBag.Operators;
}

<h2>@Loc["positions.edit.title"]</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Version" />

    <div class="mb-3">
        <label class="form-label">@Loc["positions.edit.name"]</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">@Loc["positions.edit.shortDescription"]</label>
        <textarea asp-for="ShortDescription" class="form-control">@Model.ShortDescription</textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">@Loc["positions.edit.maxProjects"]</label>
        <input asp-for="MaxProjects"
               type="number"
               min="0"
               class="form-control"
               style="max-width: 150px;" />
    </div>

    <div class="mb-3">
        <label class="form-label">@Loc["positions.edit.projectTags"]</label>
        <input asp-for="ProjectTagsRaw" class="form-control" />
    </div>

    <div class="mb-3 form-check">
        <input asp-for="Open"
               class="form-check-input"
               type="checkbox" />
        <label asp-for="Open" class="form-check-label">
            @Loc["positions.edit.open"]
        </label>
    </div>

    <h5 class="mt-4">@Loc["positions.edit.attributes"]</h5>

    <div style="max-height: 400px; overflow-y: auto;">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@Loc["positions.edit.include"]</th>
                    <th>@Loc["positions.edit.attribute"]</th>
                    <th>@Loc["positions.edit.category"]</th>
                    <th>@Loc["positions.edit.dataType"]</th>
                    <th>@Loc["positions.edit.required"]</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var attr in allAttributes)
                {
                    var included = Model.SelectedAttributeIds.Contains(attr.Id);
                    var required = Model.RequiredAttributeIds.Contains(attr.Id);

                    <tr>
                        <td>
                            <input type="checkbox"
                                   name="SelectedAttributeIds"
                                   value="@attr.Id"
                                   checked="@included" />
                        </td>

                        <td>@attr.Name</td>
                        <td>@attr.CategoryName</td>
                        <td>@attr.DataType</td>

                        <td>
                            <input type="checkbox"
                                   name="RequiredAttributeIds"
                                   value="@attr.Id"
                                   checked="@required" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h5 class="mt-4">@Loc["positions.edit.accessRules"]</h5>

    <p class="text-muted small">
        @Loc["positions.edit.accessRulesHint"]
    </p>

    <div id="rules-container">
        @for (var i = 0; i < Model.RuleAttributeIds.Length; i++)
        {
            <div class="row g-2 mb-2 rule-row">
                <div class="col-4">
                    <select name="RuleAttributeIds" class="form-select">
                        <option value="0">
                            @Loc["positions.edit.attributePlaceholder"]
                        </option>

                        @foreach (var attr in allAttributes)
                        {
                            <option value="@attr.Id"
                                    selected="@(attr.Id == Model.RuleAttributeIds[i])">
                                @attr.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-3">
                    <select name="RuleOperators" class="form-select">
                        @foreach (var op in operators)
                        {
                            <option value="@op"
                                    selected="@(op == Model.RuleOperators[i])">
                                @op
                            </option>
                        }
                    </select>
                </div>

                <div class="col-3">
                    <input type="text"
                           name="RuleExpectedValues"
                           class="form-control"
                           value="@Model.RuleExpectedValues[i]" />
                </div>

                <div class="col-2">
                    <button type="button"
                            class="btn btn-outline-danger remove-rule-btn">
                        @Loc["positions.edit.removeRule"]
                    </button>
                </div>
            </div>
        }
    </div>

    <button type="button"
            id="add-rule-btn"
            class="btn btn-sm btn-outline-secondary mb-3">
        @Loc["positions.edit.addRule"]
    </button>

    <div>
        <button type="submit" class="btn btn-primary">
            @Loc["positions.edit.save"]
        </button>

        <a asp-action="Index" class="btn btn-link">
            @Loc["positions.edit.cancel"]
        </a>
    </div>
</form>

<template id="rule-row-template">
    <div class="row g-2 mb-2 rule-row">
        <div class="col-4">
            <select name="RuleAttributeIds" class="form-select">
                <option value="0">
                    @Loc["positions.edit.attributePlaceholder"]
                </option>

                @foreach (var attr in allAttributes)
                {
                    <option value="@attr.Id">@attr.Name</option>
                }
            </select>
        </div>

        <div class="col-3">
            <select name="RuleOperators" class="form-select">
                @foreach (var op in operators)
                {
                    <option value="@op">@op</option>
                }
            </select>
        </div>

        <div class="col-3">
            <input type="text"
                   name="RuleExpectedValues"
                   class="form-control"
                   placeholder="@Loc["positions.edit.expectedValue"]" />
        </div>

        <div class="col-2">
            <button type="button"
                    class="btn btn-outline-danger remove-rule-btn">
                @Loc["positions.edit.removeRule"]
            </button>
        </div>
    </div>
</template>

@section Scripts {
    <script>
        document.querySelectorAll('.remove-rule-btn').forEach(btn => {
            btn.addEventListener('click', e => e.target.closest('.rule-row').remove());
        });

        document.getElementById('add-rule-btn').addEventListener('click', () => {
            const template = document.getElementById('rule-row-template');
            const clone = template.content.cloneNode(true);

            clone.querySelector('.remove-rule-btn').addEventListener('click', e => {
                e.target.closest('.rule-row').remove();
            });

            document.getElementById('rules-container').appendChild(clone);
        });
    </script>
}