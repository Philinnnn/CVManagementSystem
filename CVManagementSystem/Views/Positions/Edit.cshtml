@model PositionFormViewModel
@{
    ViewData["Title"] = "Edit Position";
    var allAttributes = (List<AttributeDto>)ViewBag.AllAttributes;
    var operators = (IReadOnlyCollection<string>)ViewBag.Operators;
}

<h2>Edit Position</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Version" />

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Short Description</label>
        <textarea asp-for="ShortDescription" class="form-control">@Model.ShortDescription</textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Max Projects in CV</label>
        <input asp-for="MaxProjects" type="number" min="0" class="form-control" style="max-width: 150px;" />
    </div>
    <div class="mb-3">
        <label class="form-label">Project Tags (comma-separated)</label>
        <input asp-for="ProjectTagsRaw" class="form-control" />
    </div>
    <div class="mb-3 form-check">
        <input asp-for="Open" class="form-check-input" type="checkbox" />
        <label asp-for="Open" class="form-check-label">Open (accepting new CVs)</label>
    </div>

    <h5 class="mt-4">Attributes</h5>
    <div style="max-height: 400px; overflow-y: auto;">
        <table class="table table-sm">
            <thead>
            <tr><th>Include</th><th>Attribute</th><th>Category</th><th>Data Type</th><th>Required</th></tr>
            </thead>
            <tbody>
            @foreach (var attr in allAttributes)
            {
                var included = Model.SelectedAttributeIds.Contains(attr.Id);
                var required = Model.RequiredAttributeIds.Contains(attr.Id);
                <tr>
                    <td><input type="checkbox" name="SelectedAttributeIds" value="@attr.Id" checked="@included" /></td>
                    <td>@attr.Name</td>
                    <td>@attr.CategoryName</td>
                    <td>@attr.DataType</td>
                    <td><input type="checkbox" name="RequiredAttributeIds" value="@attr.Id" checked="@required" /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <h5 class="mt-4">Access Rules</h5>
    <p class="text-muted small">Leave empty for a public position. If you add rules, a candidate must satisfy <strong>all</strong> of them.</p>
    <div id="rules-container">
        @for (var i = 0; i < Model.RuleAttributeIds.Length; i++)
        {
            <div class="row g-2 mb-2 rule-row">
                <div class="col-4">
                    <select name="RuleAttributeIds" class="form-select">
                        <option value="0">-- attribute --</option>
                        @foreach (var attr in allAttributes)
                        {
                            <option value="@attr.Id" selected="@(attr.Id == Model.RuleAttributeIds[i])">@attr.Name</option>
                        }
                    </select>
                </div>
                <div class="col-3">
                    <select name="RuleOperators" class="form-select">
                        @foreach (var op in operators)
                        {
                            <option value="@op" selected="@(op == Model.RuleOperators[i])">@op</option>
                        }
                    </select>
                </div>
                <div class="col-3">
                    <input type="text" name="RuleExpectedValues" class="form-control" value="@Model.RuleExpectedValues[i]" />
                </div>
                <div class="col-2">
                    <button type="button" class="btn btn-outline-danger remove-rule-btn">Remove</button>
                </div>
            </div>
        }
    </div>
    <button type="button" id="add-rule-btn" class="btn btn-sm btn-outline-secondary mb-3">+ Add Rule</button>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

<template id="rule-row-template">
    <div class="row g-2 mb-2 rule-row">
        <div class="col-4">
            <select name="RuleAttributeIds" class="form-select">
                <option value="0">-- attribute --</option>
                @foreach (var attr in allAttributes)
                {
                    <option value="@attr.Id">@attr.Name</option>
                }
            </select>
        </div>
        <div class="col-3">
            <select name="RuleOperators" class="form-select">
                @foreach (var op in operators)
                {
                    <option value="@op">@op</option>
                }
            </select>
        </div>
        <div class="col-3">
            <input type="text" name="RuleExpectedValues" class="form-control" placeholder="expected value" />
        </div>
        <div class="col-2">
            <button type="button" class="btn btn-outline-danger remove-rule-btn">Remove</button>
        </div>
    </div>
</template>

@section Scripts {
    <script>
        document.querySelectorAll('.remove-rule-btn').forEach(btn => {
            btn.addEventListener('click', e => e.target.closest('.rule-row').remove());
        });

        document.getElementById('add-rule-btn').addEventListener('click', () => {
            const template = document.getElementById('rule-row-template');
            const clone = template.content.cloneNode(true);
            clone.querySelector('.remove-rule-btn').addEventListener('click', e => {
                e.target.closest('.rule-row').remove();
            });
            document.getElementById('rules-container').appendChild(clone);
        });
    </script>
}