@model PositionDto
@{
    ViewData["Title"] = Model.Name;
    var cvs = (List<CvListItemDto>)ViewBag.Cvs;
}

<h2>@Model.Name</h2>
<p>@Model.ShortDescription</p>
<p class="text-muted">Created by @Model.CreatorName on @Model.CreatedAt.ToString("yyyy-MM-dd") — @(Model.Open ? "Open" : "Closed")</p>

@if (Model.ProjectTags.Count > 0)
{
    <p><strong>Relevant project tags:</strong> @string.Join(", ", Model.ProjectTags)</p>
}

<h5>Attributes in this CV</h5>
<ul>
    @foreach (var a in Model.Attributes)
    {
        <li>@a.AttributeName (@a.DataType) @(a.Required ? "— required" : "")</li>
    }
</ul>

@if (User.IsInRole("Candidate"))
{
    <div class="mt-3">
        @if (ViewBag.CandidateAlreadyApplied == true)
        {
            <p class="text-success">You already have a CV for this position.</p>
        }
        else if (ViewBag.CandidateHasAccess == true)
        {
            <form asp-controller="Cvs" asp-action="Create" method="post">
                <input type="hidden" name="positionId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary">Create my CV for this position</button>
            </form>
        }
        else
        {
            <p class="text-muted">You don't meet the access requirements for this position.</p>
        }
    </div>
}

@if (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
{
    <h5 class="mt-4">Submitted CVs (@cvs.Count)</h5>
    <table class="table table-striped">
        <thead><tr><th>Candidate</th><th>Likes</th></tr></thead>
        <tbody>
            @foreach (var cv in cvs)
            {
                <tr>
                    <td><a asp-controller="Cvs" asp-action="Details" asp-route-id="@cv.Id">@cv.CandidateName</a></td>
                    <td>@cv.LikeCount</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit position</a>
}

@if (User.Identity?.IsAuthenticated == true)
{
    @await Html.PartialAsync("_DiscussionWidget", new DiscussionWidgetViewModel
    {
        PositionId = Model.Id,
        CanLinkToProfiles = User.IsInRole("Recruiter") || User.IsInRole("Administrator")
    })
}