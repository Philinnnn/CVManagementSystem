@model PositionDto
@{
    ViewData["Title"] = Model.Name;
    var cvs = (List<CvListItemDto>)ViewBag.Cvs;
}

<script>window.ticketPositionName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name));</script>

<h2>@Model.Name</h2>
<p>@Model.ShortDescription</p>

<p class="text-muted">
    @Loc["positions.details.createdBy"] @Model.CreatorName
    @Loc["positions.details.on"] @Model.CreatedAt.ToString("yyyy-MM-dd")
    — @(Model.Open
        ? Loc["positions.details.open"]
        : Loc["positions.details.closed"])
</p>

@if (Model.ProjectTags.Count > 0)
{
    <p>
        <strong>@Loc["positions.details.relevantProjectTags"]:</strong>
        @string.Join(", ", Model.ProjectTags)
    </p>
}

<h5>@Loc["positions.details.attributesInCv"]</h5>

<ul>
    @foreach (var a in Model.Attributes)
    {
        <li>
            @a.AttributeName (@a.DataType)
            @(a.Required ? Loc["positions.details.required"] : "")
        </li>
    }
</ul>

@if (User.IsInRole("Candidate"))
{
    <div class="mt-3">
        @if (ViewBag.CandidateAlreadyApplied == true)
        {
            <p class="text-success">
                @Loc["positions.details.alreadyApplied"]
            </p>
        }
        else if (ViewBag.CandidateHasAccess == true)
        {
            <form asp-controller="Cvs"
                  asp-action="Create"
                  method="post">
                <input type="hidden"
                       name="positionId"
                       value="@Model.Id" />

                <button type="submit" class="btn btn-primary">
                    @Loc["positions.details.createCv"]
                </button>
            </form>
        }
        else
        {
            <p class="text-muted">
                @Loc["positions.details.noAccess"]
            </p>
        }
    </div>
}

@if (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
{
    <h5 class="mt-4">
        @Loc["positions.details.submittedCvs"] (@cvs.Count)
    </h5>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Loc["positions.details.candidate"]</th>
                <th>@Loc["positions.details.likes"]</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var cv in cvs)
            {
                <tr>
                    <td>
                        <a asp-controller="Cvs"
                           asp-action="Details"
                           asp-route-id="@cv.Id">
                            @cv.CandidateName
                        </a>
                    </td>
                    <td>@cv.LikeCount</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-outline-secondary">
        @Loc["positions.details.editPosition"]
    </a>
    
    @if (TempData["ApiToken"] != null)
    {
        <div class="alert alert-info">
            @Loc["positions.details.apiToken"] <code>@TempData["ApiToken"]</code><br/>
            <small>@Loc["positions.details.apiEndpoint"] <code>/api/positions/@TempData["ApiToken"]/aggregate</code></small>
        </div>
    }
    <form asp-action="GenerateApiToken" asp-route-id="@Model.Id" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-secondary">@Loc["positions.details.getApiToken"]</button>
    </form>
}

@if (User.Identity?.IsAuthenticated == true)
{
    @await Html.PartialAsync(
        "_DiscussionWidget",
        new DiscussionWidgetViewModel
        {
            PositionId = Model.Id,
            CanLinkToProfiles =
                User.IsInRole("Recruiter") ||
                User.IsInRole("Administrator")
        })
}