@model List<PositionListItemDto>
@{
    ViewData["Title"] = "Positions";
}

<h2>Positions</h2>

@if (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
{
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">+ New Position</a>
    </div>
}

<form asp-action="Delete" method="post" onsubmit="return confirm('Delete selected position(s)?');">
    <div class="d-flex align-items-center gap-2 mb-2">
        @if (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
        {
            <button type="button" id="edit-btn" class="btn btn-sm btn-outline-secondary" disabled>Edit</button>
            <button type="submit" id="duplicate-btn" class="btn btn-sm btn-outline-secondary" disabled formaction="@Url.Action("Duplicate")">Duplicate</button>
            <button type="submit" id="delete-btn" class="btn btn-sm btn-outline-danger" disabled>Delete</button>
        }
        <span id="selection-count" class="text-muted small"></span>
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th style="width: 2rem;"><input type="checkbox" id="select-all" /></th>
                <th>Name</th>
                <th>Short Description</th>
                <th>Created</th>
                <th>Status</th>
                <th>CVs</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><input type="checkbox" class="row-check" name="ids" value="@p.Id" /></td>
                    <td><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a></td>
                    <td>@p.ShortDescription</td>
                    <td>@p.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@(p.Open ? "Open" : "Closed")</td>
                    <td>@p.CvCount</td>
                </tr>
            }
        </tbody>
    </table>
</form>

@section Scripts {
    <script>
        const rowChecks = document.querySelectorAll('.row-check');
        const selectAll = document.getElementById('select-all');
        const editBtn = document.getElementById('edit-btn');
        const duplicateBtn = document.getElementById('duplicate-btn');
        const deleteBtn = document.getElementById('delete-btn');
        const countLabel = document.getElementById('selection-count');

        function updateToolbar() {
            const checkedBoxes = document.querySelectorAll('.row-check:checked');
            if (deleteBtn) deleteBtn.disabled = checkedBoxes.length === 0;
            if (editBtn) editBtn.disabled = checkedBoxes.length !== 1;
            if (duplicateBtn) duplicateBtn.disabled = checkedBoxes.length !== 1;
            countLabel.textContent = checkedBoxes.length > 0 ? checkedBoxes.length + ' selected' : '';
        }

        rowChecks.forEach(cb => cb.addEventListener('change', updateToolbar));

        selectAll.addEventListener('change', () => {
            rowChecks.forEach(cb => cb.checked = selectAll.checked);
            updateToolbar();
        });

        if (editBtn) {
            editBtn.addEventListener('click', () => {
                const checkedBox = document.querySelector('.row-check:checked');
                if (checkedBox) window.location.href = '@Url.Action("Edit")/' + checkedBox.value;
            });
        }
    </script>
}