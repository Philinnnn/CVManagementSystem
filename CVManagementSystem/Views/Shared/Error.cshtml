@model ErrorViewModel
@{
    ViewData["Title"] = Loc["error.title"];
}

<h1 class="text-danger">@Loc["error.heading"]</h1>
<h2 class="text-danger">@Loc["error.message"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Loc["error.requestId"]:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Loc["error.developmentMode"]</h3>
<p>
    @Loc["error.developmentDescription"]
</p>
<p>
    <strong>@Loc["error.developmentWarning"]</strong>
    @Loc["error.developmentSensitiveInfo"]
    @Loc["error.developmentLocalDebugging"]
</p>