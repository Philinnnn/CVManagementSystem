<!DOCTYPE html>
@{
    var theme = Context.Request.Cookies["theme"] ?? "light";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<html lang="@currentCulture" data-bs-theme="@theme">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - CVManagementSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/CVManagementSystem.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">CVManagementSystem</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto gap-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">@Loc["nav.home"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Positions" asp-action="Index">@Loc["nav.positions"]</a></li>
                    @if (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Attributes" asp-action="Index">@Loc["nav.attributes"]</a></li>
                    }
                    @if (User.IsInRole("Candidate"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Candidates" asp-action="Index">@Loc["nav.myProfile"]</a></li>
                    }
                    @if (User.IsInRole("Administrator"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">@Loc["nav.users"]</a></li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <form asp-controller="Search" asp-action="Index" method="get" role="search">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
                            <input type="text" name="q" class="form-control" placeholder="@Loc["nav.search.placeholder"]" style="width: 220px;"/>
                        </div>
                    </form>

                    <form asp-controller="Settings" asp-action="SetTheme" method="post">
                        <input type="hidden" name="returnUrl" value="@returnUrl"/>
                        <input type="hidden" name="theme" value="@(theme == "dark" ? "light" : "dark")"/>
                        <button type="submit" class="btn btn-icon" title="Toggle theme" aria-label="Toggle theme">
                            <i class="bi @(theme == "dark" ? "bi-sun" : "bi-moon-stars")"></i>
                        </button>
                    </form>

                    <div class="dropdown">
                        <button class="btn btn-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Language">
                            <i class="bi bi-globe2"></i> @currentCulture.ToUpperInvariant()
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-controller="Settings" asp-action="SetLanguage" method="post">
                                    <input type="hidden" name="returnUrl" value="@returnUrl"/>
                                    <input type="hidden" name="culture" value="en"/>
                                    <button type="submit" class="dropdown-item @(currentCulture == "en" ? "active" : "")">English</button>
                                </form>
                            </li>
                            <li>
                                <form asp-controller="Settings" asp-action="SetLanguage" method="post">
                                    <input type="hidden" name="returnUrl" value="@returnUrl"/>
                                    <input type="hidden" name="culture" value="ru"/>
                                    <button type="submit" class="dropdown-item @(currentCulture == "ru" ? "active" : "")">Русский</button>
                                </form>
                            </li>
                        </ul>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span class="d-none d-md-inline">@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">@Loc["nav.signedInAs"] @User.Identity.Name</h6></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage">Account Settings</a></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-2"></i>@Loc["nav.logout"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary">@Loc["nav.login"]</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary">@Loc["nav.register"]</a>
                    }
                    @if (Context.Request.Query.ContainsKey("externalError"))
                    {
                        <div class="alert alert-danger">@Context.Request.Query["externalError"]</div>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="footer text-muted">
    <div class="container">
        &copy; 2026 — CVManagementSystem
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    window.CLOUDINARY_CLOUD_NAME = "@Configuration["Cloudinary:CloudName"]";
    window.CLOUDINARY_UPLOAD_PRESET = "@Configuration["Cloudinary:UploadPreset"]";
</script>
<script src="https://upload-widget.cloudinary.com/global/all.js"></script>
<script src="~/js/image-upload.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>