<!DOCTYPE html>
@{
    var theme = Context.Request.Cookies["theme"] ?? "light";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<html lang="@currentCulture" data-bs-theme="@theme">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - CVManagementSystem</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%2333553F'/%3E%3Ctext x='50' y='68' font-family='Georgia,serif' font-size='48' font-weight='700' fill='%23F7F5EF' text-anchor='middle'%3ECV%3C/text%3E%3C/svg%3E" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/CVManagementSystem.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">CVManagementSystem</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto gap-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">@Loc["nav.home"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Positions" asp-action="Index">@Loc["nav.positions"]</a></li>
                    @if (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Attributes" asp-action="Index">@Loc["nav.attributes"]</a></li>
                    }
                    @if (User.IsInRole("Candidate"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Candidates" asp-action="Index">@Loc["nav.myProfile"]</a></li>
                    }
                    @if (User.IsInRole("Administrator"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">@Loc["nav.users"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Integrations" asp-action="Index">@Loc["nav.integrations"]</a></li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <form asp-controller="Search" asp-action="Index" method="get" role="search">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
                            <input type="text" name="q" class="form-control" placeholder="@Loc["nav.search.placeholder"]" style="width: 220px;"/>
                        </div>
                    </form>

                    <form asp-controller="Settings" asp-action="SetTheme" method="post">
                        <input type="hidden" name="returnUrl" value="@returnUrl"/>
                        <input type="hidden" name="theme" value="@(theme == "dark" ? "light" : "dark")"/>
                        <button type="submit" class="btn btn-icon" title="Toggle theme" aria-label="Toggle theme">
                            <i class="bi @(theme == "dark" ? "bi-sun" : "bi-moon-stars")"></i>
                        </button>
                    </form>

                    <div class="dropdown">
                        <button class="btn btn-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Language">
                            <i class="bi bi-globe2"></i> @currentCulture.ToUpperInvariant()
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-controller="Settings" asp-action="SetLanguage" method="post">
                                    <input type="hidden" name="returnUrl" value="@returnUrl"/>
                                    <input type="hidden" name="culture" value="en"/>
                                    <button type="submit" class="dropdown-item @(currentCulture == "en" ? "active" : "")">English</button>
                                </form>
                            </li>
                            <li>
                                <form asp-controller="Settings" asp-action="SetLanguage" method="post">
                                    <input type="hidden" name="returnUrl" value="@returnUrl"/>
                                    <input type="hidden" name="culture" value="ru"/>
                                    <button type="submit" class="dropdown-item @(currentCulture == "ru" ? "active" : "")">Русский</button>
                                </form>
                            </li>
                        </ul>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span class="d-none d-md-inline">@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">@Loc["nav.signedInAs"] @User.Identity.Name</h6></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage">@Loc["nav.accountSettings"]</a></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-2"></i>@Loc["nav.logout"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary">@Loc["nav.login"]</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary">@Loc["nav.register"]</a>
                    }
                    @if (Context.Request.Query.ContainsKey("externalError"))
                    {
                        <div class="alert alert-danger">@Context.Request.Query["externalError"]</div>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="footer text-muted">
    <div class="container d-flex justify-content-between align-items-center">
        <span>&copy; 2026 — CVManagementSystem</span>
        <a href="#" data-bs-toggle="modal" data-bs-target="#supportTicketModal">
            <i class="bi bi-question-circle me-1"></i>@Loc["support.footerLink"]
        </a>
    </div>
</footer>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success position-fixed bottom-0 end-0 m-3" style="z-index: 2000;">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger position-fixed bottom-0 end-0 m-3" style="z-index: 2000;">@TempData["Error"]</div>
}

<div class="modal fade" id="supportTicketModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Support" asp-action="CreateTicket" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">@Loc["support.modal.title"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="link" id="ticket-link" />
                    <input type="hidden" name="positionName" id="ticket-position" />
                    <div class="mb-3">
                        <label class="form-label">@Loc["support.modal.summaryLabel"]</label>
                        <textarea name="summary" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Loc["support.modal.priorityLabel"]</label>
                        <select name="priority" class="form-select">
                            <option value="High">@Loc["support.modal.priorityHigh"]</option>
                            <option value="Average" selected>@Loc["support.modal.priorityAverage"]</option>
                            <option value="Low">@Loc["support.modal.priorityLow"]</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">@Loc["support.modal.submit"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('supportTicketModal').addEventListener('show.bs.modal', () => {
        document.getElementById('ticket-link').value = window.location.href;
        document.getElementById('ticket-position').value = window.ticketPositionName || '';
    });
</script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    window.CLOUDINARY_CLOUD_NAME = "@Configuration["Cloudinary:CloudName"]";
    window.CLOUDINARY_UPLOAD_PRESET = "@Configuration["Cloudinary:UploadPreset"]";
</script>
<script src="https://upload-widget.cloudinary.com/global/all.js"></script>
<script src="~/js/image-upload.js" asp-append-version="true"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.0/marked.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.9/purify.min.js"></script>
<script src="~/js/markdown-render.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>