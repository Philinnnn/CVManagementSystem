@{
    ViewData["Title"] = Loc["account.salesforce.title"];
}

<h2>@Loc["account.salesforce.title"]</h2>
<p class="text-muted">@Loc["account.salesforce.description"]</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="SyncSalesforce" method="post">
    <div class="mb-3">
        <label class="form-label">@Loc["account.salesforce.companyLabel"]</label>
        <input name="CompanyName" class="form-control" placeholder="@Loc["account.salesforce.companyPlaceholder"]" />
    </div>
    <div class="mb-3">
        <label class="form-label">@Loc["account.salesforce.phoneLabel"]</label>
        <input name="Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">@Loc["account.salesforce.jobTitleLabel"]</label>
        <input name="JobTitle" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">@Loc["account.salesforce.notesLabel"]</label>
        <textarea name="Notes" class="form-control" rows="3"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">@Loc["account.salesforce.submit"]</button>
    <a asp-action="Manage" class="btn btn-link">@Loc["account.salesforce.cancel"]</a>
</form>