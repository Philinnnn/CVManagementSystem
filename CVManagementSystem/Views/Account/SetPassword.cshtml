@{
    ViewData["Title"] = Loc["account.setPassword.title"];
}

<h2>@ViewData["Title"]</h2>

@if (TempData["Notice"] != null)
{
    <div class="alert alert-info">@TempData["Notice"]</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="SetPassword" method="post">
    <div class="mb-3">
        <label class="form-label">@Loc["account.setPassword.newPassword"]</label>
        <input type="password" name="newPassword" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">@Loc["account.setPassword.confirmPassword"]</label>
        <input type="password" name="confirmPassword" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">@Loc["account.setPassword.save"]</button>
    <a asp-action="Manage" class="btn btn-link">@Loc["account.setPassword.cancel"]</a>
</form>