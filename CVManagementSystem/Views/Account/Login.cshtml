@model CVManagementSystem.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = Loc["account.login.title"];
}

<h2>@Loc["account.login.title"]</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">@Loc["account.login.passwordLabel"]</label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">@Loc["account.login.submit"]</button>
    <a asp-action="Register" class="btn btn-link">@Loc["account.login.registerLink"]</a>
    <hr class="my-3" />
    <div class="d-grid gap-2">
        <a asp-action="ExternalLogin" asp-route-provider="Google" class="btn btn-outline-secondary">
            <i class="bi bi-google me-2"></i>Continue with Google
        </a>
        <a asp-action="ExternalLogin" asp-route-provider="GitHub" class="btn btn-outline-secondary">
            <i class="bi bi-github me-2"></i>Continue with GitHub
        </a>
    </div>
</form>