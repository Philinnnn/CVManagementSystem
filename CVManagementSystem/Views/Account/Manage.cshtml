@{
    ViewData["Title"] = Loc["account.manage.title"];
    var linked = (List<string>)ViewBag.LinkedProviders;
    var hasPassword = (bool)ViewBag.HasPassword;
}

<h2>@Loc["account.manage.title"]</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<h5>@Loc["account.manage.password"]</h5>
<p class="text-muted">
    @(hasPassword ? Loc["account.manage.hasPassword"] : Loc["account.manage.noPassword"])
</p>
<a asp-action="SetPassword" class="btn btn-sm btn-outline-secondary mb-4">
    @(hasPassword ? Loc["account.manage.changePassword"] : Loc["account.manage.setPassword"])
</a>

<h5>@Loc["account.manage.linkedAccounts"]</h5>
<ul class="list-unstyled">
    @foreach (var (provider, icon) in new[] { ("Google", "bi-google"), ("GitHub", "bi-github") })
    {
        <li class="mb-2 d-flex align-items-center gap-2">
            <i class="bi @icon"></i> @provider
            @if (linked.Contains(provider))
            {
                <form asp-action="UnlinkExternalLogin" method="post">
                    <input type="hidden" name="provider" value="@provider" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">@Loc["account.manage.unlink"]</button>
                </form>
            }
            else
            {
                <form asp-action="LinkExternalLogin" method="post">
                    <input type="hidden" name="provider" value="@provider" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">@Loc["account.manage.link"]</button>
                </form>
            }
        </li>
    }
</ul>