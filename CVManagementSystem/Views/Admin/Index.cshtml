@model List<CVManagementSystem.Services.Admin.Dtos.UserAdminDto>
@{
    ViewData["Title"] = Loc["admin.users.title"];
    var roles = (List<string>)ViewBag.Roles;
}

<h2>@Loc["admin.users.title"]</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
    <form asp-action="Block" method="post" id="block-form" class="d-inline"></form>
    <form asp-action="Unblock" method="post" id="unblock-form" class="d-inline"></form>
    <form asp-action="Delete" method="post" id="delete-form" class="d-inline"
          onsubmit="return confirm('@Loc["admin.users.deleteConfirm"]');"></form>

    <button type="submit" form="block-form" id="block-btn"
            class="btn btn-sm btn-outline-secondary" disabled>
        @Loc["admin.users.block"]
    </button>

    <button type="submit" form="unblock-form" id="unblock-btn"
            class="btn btn-sm btn-outline-secondary" disabled>
        @Loc["admin.users.unblock"]
    </button>

    <button type="submit" form="delete-form" id="delete-btn"
            class="btn btn-sm btn-outline-danger" disabled>
        @Loc["admin.users.delete"]
    </button>

    <form asp-action="AssignRole" method="post" id="assign-role-form" class="d-flex gap-1">
        <select name="roleName" class="form-select form-select-sm">
            @foreach (var r in roles)
            {
                <option value="@r">@r</option>
            }
        </select>

        <button type="submit" id="assign-role-btn"
                class="btn btn-sm btn-outline-secondary" disabled>
            @Loc["admin.users.assignRole"]
        </button>
    </form>

    <form asp-action="RemoveRole" method="post" id="remove-role-form" class="d-flex gap-1">
        <select name="roleName" class="form-select form-select-sm">
            @foreach (var r in roles)
            {
                <option value="@r">@r</option>
            }
        </select>

        <button type="submit" id="remove-role-btn"
                class="btn btn-sm btn-outline-secondary" disabled>
            @Loc["admin.users.removeRole"]
        </button>
    </form>

    <span id="selection-count" class="text-muted small"></span>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th style="width: 2rem;">
                <input type="checkbox" id="select-all" />
            </th>
            <th>@Loc["admin.users.login"]</th>
            <th>@Loc["admin.users.email"]</th>
            <th>@Loc["admin.users.fullname"]</th>
            <th>@Loc["admin.users.roles"]</th>
            <th>@Loc["admin.users.status"]</th>
            <th>@Loc["admin.users.profile"]</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>
                    <input type="checkbox" class="row-check" value="@u.Id" />
                </td>

                <td>@u.Login</td>
                <td>@u.Email</td>
                <td>@u.Fullname</td>
                <td>@string.Join(", ", u.Roles)</td>

                <td>
                    @(u.IsBlocked
                        ? Loc["admin.users.blocked"]
                        : Loc["admin.users.active"])
                </td>

                <td>
                    @if (u.CandidateId.HasValue)
                    {
                        <a asp-controller="Candidates"
                           asp-action="Index"
                           asp-route-candidateId="@u.CandidateId">
                            @Loc["admin.users.view"]
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        const forms = [
            'block-form',
            'unblock-form',
            'delete-form',
            'assign-role-form',
            'remove-role-form'
        ];

        const rowChecks = document.querySelectorAll('.row-check');
        const selectAll = document.getElementById('select-all');
        const countLabel = document.getElementById('selection-count');

        const buttons = [
            'block-btn',
            'unblock-btn',
            'delete-btn',
            'assign-role-btn',
            'remove-role-btn'
        ].map(id => document.getElementById(id));

        function updateToolbar() {
            const checked = Array.from(
                document.querySelectorAll('.row-check:checked')
            );

            forms.forEach(formId => {
                const form = document.getElementById(formId);

                form.querySelectorAll('input[name="ids"]')
                    .forEach(el => el.remove());

                checked.forEach(cb => {
                    const hidden = document.createElement('input');

                    hidden.type = 'hidden';
                    hidden.name = 'ids';
                    hidden.value = cb.value;

                    form.appendChild(hidden);
                });
            });

            buttons.forEach(btn => {
                btn.disabled = checked.length === 0;
            });

            countLabel.textContent =
                checked.length > 0
                    ? checked.length + ' @Loc["admin.users.selected"]'
                    : '';
        }

        rowChecks.forEach(cb =>
            cb.addEventListener('change', updateToolbar)
        );

        selectAll.addEventListener('change', () => {
            rowChecks.forEach(cb => {
                cb.checked = selectAll.checked;
            });

            updateToolbar();
        });
    </script>
}