@model CVManagementSystem.Services.Attributes.Dtos.CreateAttributeRequest
@{
    ViewData["Title"] = Loc["attributes.create.title"];
    var categories = (List<CategoryDto>)ViewBag.Categories;
    var dataTypes = (IReadOnlyCollection<string>)ViewBag.DataTypes;
}

<h2>@Loc["attributes.create.title"]</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">@Loc["attributes.create.name"]</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">@Loc["attributes.create.description"]</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">@Loc["attributes.create.category"]</label>
        <select asp-for="CategoryId" class="form-select" style="max-width: 400px;">
            @foreach (var c in categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">@Loc["attributes.create.dataType"]</label>
        <select asp-for="DataType" class="form-select" style="max-width: 400px;">
            @foreach (var dt in dataTypes)
            {
                <option value="@dt">@dt</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">
            @Loc["attributes.create.dropdownOptions"]
        </label>
        <textarea name="selectOptionsRaw" class="form-control" rows="4"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        @Loc["attributes.create.create"]
    </button>

    <a asp-action="Index" class="btn btn-link">
        @Loc["attributes.create.cancel"]
    </a>
</form>